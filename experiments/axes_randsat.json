{
  "description": "RandSATBench test-final load grid, all N (N=null). Same ThermoBSP axes as axes_k3n500. Alpha snap is per N; sat_labels include N.",
  "bsp": "build/release/bsp",
  "dataset": "../RandSATBench/datasets/3SAT/test-final",
  "labels": "../RandSATBench/datasets/3SAT/test_labels.csv",
  "K": 3,
  "N": null,
  "alphas": [
    3.8,
    4.0,
    4.1,
    4.2,
    4.3,
    4.4
  ],
  "alpha_tol": 0.06,
  "ids": {
    "start": 1,
    "stop": 80
  },
  "timeout_s": 120,
  "jobs": 8,
  "extra_flags": [
    "-q"
  ],
  "plot": {
    "success_vs_alpha": "Primary: which axis moves P(solve) on fixed CNFs.",
    "agreement_vs_alpha": "P(solve) split by SAT/UNSAT ground truth from labels.",
    "sigma_mean_vs_step_alphas": [
      4.0,
      4.199219,
      4.300781
    ]
  },
  "configs": [
    {
      "name": "cert",
      "axis": "baseline",
      "role": "BSP 2016 reference: hard SP, certainty scorer, fixed r.",
      "flags": [
        "--scorer=cert",
        "--r=0.9"
      ]
    },
    {
      "name": "dynI",
      "axis": "release_I",
      "role": "Hard free-entropy release via I(k).",
      "flags": [
        "--scorer=cert",
        "--r=0.9",
        "--dynamic-i-backtrack"
      ]
    },
    {
      "name": "cav_0.05",
      "axis": "T_cav",
      "role": "ThermoSP cavity temperature alone.",
      "flags": [
        "--scorer=cert",
        "--r=0.9",
        "--cav-temp=0.05"
      ]
    },
    {
      "name": "cav_0.10",
      "axis": "T_cav",
      "role": "Stronger cavity temperature.",
      "flags": [
        "--scorer=cert",
        "--r=0.9",
        "--cav-temp=0.10"
      ]
    },
    {
      "name": "rsb_0.30",
      "axis": "m",
      "role": "1RSB cluster reweighting, mild m.",
      "flags": [
        "--scorer=rsb",
        "--r=0.9",
        "--rsb-m=0.30"
      ]
    },
    {
      "name": "rsb_0.50",
      "axis": "m",
      "role": "Stronger m.",
      "flags": [
        "--scorer=rsb",
        "--r=0.9",
        "--rsb-m=0.50"
      ]
    },
    {
      "name": "act_fth",
      "axis": "T_act",
      "role": "Gibbs action temperature + free-energy scorer.",
      "flags": [
        "--scorer=fth",
        "--r=0.9",
        "--cav-temp=0.05",
        "--act-temp=0.02"
      ]
    },
    {
      "name": "fe_bt",
      "axis": "release_DeltaPhi",
      "role": "Soft release on DeltaPhi and Gibbs back/dec split.",
      "flags": [
        "--scorer=fth",
        "--cav-temp=0.05",
        "--act-temp=0.02",
        "--fe-backtrack",
        "--bt-cost=0.4"
      ]
    },
    {
      "name": "dynI_cav",
      "axis": "I_x_T_cav",
      "role": "Hard I(k) release plus mild ThermoSP messages.",
      "flags": [
        "--scorer=cert",
        "--r=0.9",
        "--cav-temp=0.05",
        "--dynamic-i-backtrack"
      ]
    },
    {
      "name": "soft_rsb",
      "axis": "T_cav_T_act_DeltaPhi_m",
      "role": "Soft package plus mild 1RSB reweighting.",
      "flags": [
        "--scorer=fth",
        "--cav-temp=0.05",
        "--act-temp=0.02",
        "--rsb-m=0.30",
        "--fe-backtrack",
        "--bt-cost=0.4"
      ]
    }
  ],
  "howto": {
    "run": "source .venv/bin/activate && bsp-grid experiments/axes_randsat.json -o experiments/axes_randsat -j 8",
    "plot": "source .venv/bin/activate && bsp-plot experiments/axes_randsat -o experiments/axes_randsat/figures"
  }
}
